# Copia este archivo a .env y define una contraseña aleatoria larga para PostgreSQL.
EDMOTOR_DB_PASSWORD=
EDMOTOR_DB_NAME=edmotor
EDMOTOR_DB_USER=edmotor

# La API queda expuesta solo en el equipo anfitrión para el proxy HTTPS.
EDMOTOR_BIND_HOST=127.0.0.1
EDMOTOR_API_PORT=8000
EDMOTOR_SESSION_HOURS=24
# Si hay un proxy HTTPS, usa su IP real vista por el contenedor Uvicorn.
EDMOTOR_FORWARDED_ALLOW_IPS=127.0.0.1
